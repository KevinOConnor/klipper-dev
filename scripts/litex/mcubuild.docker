# This is a dockerfile for building Klipper mcu images.
#
# Build this docker container with something like:
#  docker build -t mcubuild -f mcubuild.docker

FROM ubuntu:24.04

# Install software
RUN apt-get update && apt-get install -y build-essential git make \
    python3 python3-dev python-is-python3 virtualenv \
    gcc-avr binutils-avr avr-libc \
    gcc-arm-none-eabi binutils-arm-none-eabi libnewlib-arm-none-eabi \
    gcc-riscv64-unknown-elf binutils-riscv64-unknown-elf \
    picolibc-riscv64-unknown-elf
